# --- Configuration du site ---
PORT=3000
NODE_ENV=development

# --- IA (optionnelle) ---
# Pour Render, laisse AI_PROVIDER=gemini et mets une clé si tu veux activer la partie chatbot.
# Si tu ne mets pas de clé, le site fonctionne avec le moteur local de secours.
AI_PROVIDER=gemini
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_MODEL=gemini-2.5-flash

# --- Base MySQL externe (Render / Railway / Aiven / autre) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cotec
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# --- Supabase (si tu l’utilises côté front) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
